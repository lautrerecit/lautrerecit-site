  <script>
    const au = document.getElementById('au');
    const bt = document.getElementById('au-theme');
    try { const m = localStorage.getItem('au-theme'); if (m) au.dataset.theme = m; } catch (e) {}
    const maj = () => { const s = au.dataset.theme === 'sombre'; bt.textContent = s ? 'Clair' : 'Sombre'; bt.setAttribute('aria-pressed', String(s)); };
    maj();
    bt.addEventListener('click', () => { au.dataset.theme = au.dataset.theme === 'sombre' ? 'clair' : 'sombre'; maj(); try { localStorage.setItem('au-theme', au.dataset.theme); } catch (e) {} });

    // M2 — situation → dossiers
    const D = { 'vie-chere': ['Vie chère', 'Pourquoi tout augmente'], salaires: ['Salaires', 'Ce que vaut votre paie'], logement: ['Logement', 'Loyers, HLM, APL'], ecole: ['École', 'Ce qui fait réussir'], retraites: ['Retraites', 'Ce que vous toucherez'], 'services-publics': ['Services publics', 'Hôpital, guichets, médecins'], securite: ['Sécurité', 'Ce que disent les chiffres'], 'quartiers-outre-mer': ['Quartiers et outre-mer', 'Vie chère, chlordécone, budgets'] };
    const res = document.getElementById('m2-res');
    document.querySelectorAll('#m2-choix button').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll('#m2-choix button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      res.innerHTML = b.dataset.d.split(',').map((id) => `<a href="/2027/${id}/"><b>${D[id][0]}</b><span>${D[id][1]}</span></a>`).join('');
    }));

    // M3 — le fait d'abord (chiffres repris de repliques2027.js)
    const F = [
      ['1,1 % du PIB', 'C’est le poids de l’ensemble des minima sociaux, RSA compris, en 2023.', '« La vie chère, c’est à cause des assistés. »', 'DREES, Minima sociaux et prestations de solidarité, édition 2025'],
      ['9e sur 27', 'C’est le rang de la France dans l’UE pour les premières demandes d’asile rapportées à la population, en 2025.', '« La France accueille plus que tout le monde. »', 'Eurostat, migr_asyappctza et demo_gind, calcul L’Autre Récit'],
      ['−0,9 point', 'C’est l’évolution de la part de l’emploi public dans l’emploi total entre 2019 et 2023, quand la moyenne de l’OCDE gagne 0,3 point.', '« Le nombre de fonctionnaires explose. »', 'OCDE, Government at a Glance 2025'],
    ];
    let i = 0;
    document.getElementById('m3-suiv').addEventListener('click', () => {
      i = (i + 1) % F.length;
      [['m3-val', 0], ['m3-fait', 1], ['m3-on', 2], ['m3-src', 3]].forEach(([id, k]) => { document.getElementById(id).textContent = F[i][k]; });
    });

    // C2 — trois verdicts
    document.querySelectorAll('#c2 [data-v]').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll('#c2 [data-v]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.getElementById('c2-rep').hidden = false;
    }));

    // C3 — devinez le chiffre
    const r = document.getElementById('c3-r'), o = document.getElementById('c3-o');
    r.addEventListener('input', () => { o.textContent = r.value + ' %'; });
    document.getElementById('c3-v').addEventListener('click', () => {
      document.getElementById('c3-rep').hidden = false;
      document.getElementById('c3-bv').style.width = (r.value * 2) + '%';
      document.getElementById('c3-tv').textContent = r.value + ' %';
    });
  </script>
</Base>
