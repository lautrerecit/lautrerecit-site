---
// Le caddie qui se vide — même budget, 2017 puis 2025 (alimentation +31,1 %, Insee).
// Seuls les deux points publiés sont montrés : aucune année intermédiaire inventée.
const produits = Array.from({ length: 25 }, (_, i) => i);
const vagues = [1, 2, 3, 4, 5, 6, 7, 8];
---
<div class="cd">
  <div class="cd-annees" role="group" aria-label="Choisir l'année">
    <button type="button" class="cd-an" aria-pressed="true" data-an="2017">2017</button>
    <button type="button" class="cd-an" aria-pressed="false" data-an="2025">2025</button>
  </div>
  <div class="cd-chariot">
    <div class="cd-panier">
      {produits.map((i) => <span class="cd-produit" style={`height:${24 + ((i * 7) % 4) * 8}px`}></span>)}
    </div>
    <svg viewBox="0 0 520 290" aria-hidden="true">
      <defs><linearGradient id="cdOr" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#EBCB70" /><stop offset="1" stop-color="#9A7B2E" /></linearGradient></defs>
      <path d="M6 26 H48 L62 40" fill="none" stroke="url(#cdOr)" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
      <polygon points="60,40 500,40 460,200 110,200" fill="rgba(196,162,74,0.07)" stroke="url(#cdOr)" stroke-width="6" stroke-linejoin="round" />
      {vagues.map((k) => <line x1={60 + k * 440 / 9} y1="40" x2={110 + k * 350 / 9} y2="200" stroke="#B8924A" stroke-opacity=".55" stroke-width="2" />)}
      <line x1="72" y1="95" x2="487" y2="95" stroke="#B8924A" stroke-opacity=".55" stroke-width="2" />
      <line x1="85" y1="150" x2="474" y2="150" stroke="#B8924A" stroke-opacity=".55" stroke-width="2" />
      <path d="M110 200 L124 244 H446 L460 200" fill="none" stroke="url(#cdOr)" stroke-width="7" stroke-linejoin="round" />
      <circle cx="150" cy="264" r="17" fill="#1A1714" stroke="#C4A24A" stroke-width="4" />
      <circle cx="420" cy="264" r="17" fill="#1A1714" stroke="#C4A24A" stroke-width="4" />
    </svg>
  </div>
  <div class="cd-texte">
    <span class="cd-n" aria-live="polite"><span id="cd-n">25</span><small> / 25</small></span>
    <span class="cd-sous">produits dans le caddie</span>
    <p class="cd-p" id="cd-p">En 2017, votre budget remplit le caddie.</p>
    <p class="cd-src">Insee, indices annuels des prix de l’alimentation 2017-2025, calcul L'Autre Récit : 25 / 1,311 ≈ 19. Moyenne de tous les produits alimentaires.</p>
  </div>
</div>

<style is:global>
  .cd { display: grid; grid-template-columns: 1.3fr 1fr; gap: 10px 34px; align-items: center; margin-top: 28px; background: var(--r-carte); border: 1px solid var(--r-filet); border-radius: 18px; padding: clamp(22px, 3vw, 40px); }
  .cd-annees { grid-column: 1 / -1; justify-self: start; display: inline-flex; padding: 4px; border: 1px solid var(--cr3); border-radius: 100px; background: var(--cr); }
  .cd-an { font: inherit; font-family: var(--serif); font-weight: 700; font-size: 20px; padding: 8px 24px; border: 0; border-radius: 100px; background: transparent; color: var(--ink3); cursor: pointer; transition: background .3s, color .3s; }
  .cd-an[aria-pressed="true"] { background: var(--ink); color: var(--or2); }
  .cd-chariot { position: relative; margin-top: 52px; }
  .cd-chariot svg { position: relative; z-index: 2; display: block; width: 100%; height: auto; pointer-events: none; }
  .cd-panier { position: absolute; z-index: 1; left: 22%; right: 13%; bottom: 33%; display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; align-items: end; }
  .cd-produit { border-radius: 4px 4px 2px 2px; background: linear-gradient(180deg, #F6EAD0, #E2D2B4); border: 1px solid #CBB894; box-shadow: inset 0 6px 0 rgba(196,162,74,.55), 0 4px 8px -4px rgba(14,12,10,.3); transition: transform .7s var(--ease), opacity .5s; transition-delay: calc(var(--d, 0) * 70ms); }
  .cd-produit:nth-child(3n) { background: linear-gradient(180deg, #2A221A, #14100C); border-color: #3A3028; box-shadow: inset 0 6px 0 var(--or2), 0 4px 8px -4px rgba(14,12,10,.4); }
  .cd-produit:nth-child(5n+2) { background: linear-gradient(180deg, #E9CF8A, #B8924A); border-color: #9A7B2E; box-shadow: inset 0 6px 0 #FBEFC2, 0 4px 8px -4px rgba(14,12,10,.3); }
  .cd-produit.parti { transform: translate(var(--tx), -170px) rotate(var(--rot)) scale(.6); opacity: 0; }
  .cd-texte { display: flex; flex-direction: column; }
  .cd-n { font-family: var(--serif); font-weight: 700; font-size: clamp(76px, 9vw, 116px); line-height: .95; letter-spacing: -0.04em; color: var(--ink); }
  .cd-n small { font-size: .32em; letter-spacing: 0; color: #7A5E18; }
  .cd-sous { font-family: var(--mono); font-size: 13px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #7A5E18; margin-top: 16px; }
  .cd-p { font-size: 18px; line-height: 1.5; color: var(--ink2); margin: 16px 0 0; }
  .cd-src { font-size: 13.5px; line-height: 1.45; color: #5A5046; margin: 14px 0 0; }
  @media (max-width: 900px) { .cd { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .cd-panier { gap: 3px; } .cd-chariot { margin-top: 78px; } }
  @media (prefers-reduced-motion: reduce) { .cd-produit { transition: none; } }
</style>

<script is:inline>
  (function () {
    var produits = document.querySelectorAll('.cd-produit');
    var reste = Math.round(25 / 1.311);
    var partants = [1, 5, 3, 0, 6, 2]; // rangée du dessus
    var n = document.getElementById('cd-n'), p = document.getElementById('cd-p');
    document.querySelectorAll('.cd-an').forEach(function (b) {
      b.addEventListener('click', function () {
        document.querySelectorAll('.cd-an').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        var en2025 = b.dataset.an === '2025';
        partants.forEach(function (i, k) {
          var el = produits[i];
          el.style.setProperty('--d', k);
          el.style.setProperty('--tx', (k % 2 ? -1 : 1) * (40 + k * 18) + 'px');
          el.style.setProperty('--rot', (k % 2 ? -1 : 1) * (20 + k * 9) + 'deg');
          el.classList.toggle('parti', en2025);
        });
        n.textContent = en2025 ? reste : 25;
        p.textContent = en2025 ? 'Avec la même somme en 2025, il n’en reste que ' + reste + ' : 6 produits restent en rayon.' : 'En 2017, votre budget remplit le caddie.';
      });
    });
  })();
</script>
