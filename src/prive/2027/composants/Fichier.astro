---
// Le fichier — les dix dossiers en intercalaires ivoire penchés vers l'arrière.
// Chaque intercalaire montre son titre et son chiffre-clé ; au survol (ou au focus clavier) il se redresse et dévoile sa question.
// Sur écran tactile, il n'y a pas de survol : l'intercalaire est un lien direct vers le dossier.
import { enjeux } from '../../../data/repliques2027.js';
const D = enjeux.map((e, i) => ({ id: e.id, n: String(i + 1).padStart(2, '0'), titre: e.titre, question: e.question, valeur: e.etat[0].valeur }));
---
<div class="fi">
  {D.map((e, i) => (
    <a class="fi-fiche" href={`/2027/${e.id}/`} style={`--i:${i}`}>
      <span class="fi-onglet">{e.n}</span>
      <span class="fi-ligne"><span class="fi-t">{e.titre}</span><span class="fi-v">{e.valeur}</span></span>
      <span class="fi-corps"><span class="fi-q">{e.question}</span><span class="fi-go">Ouvrir le dossier →</span></span>
    </a>
  ))}
</div>

<style is:global>
  .fi { margin-top: 56px; perspective: 1100px; perspective-origin: 50% -20%; display: grid; justify-items: center; }
  .fi-fiche { position: relative; display: block; width: min(100%, 760px); height: 150px; margin-top: -80px; padding: 12px 28px; border-radius: 16px; text-decoration: none; transform-origin: 50% 100%;
    transform: rotateX(-26deg); background: linear-gradient(180deg, #FFFCF5, #ECE1CB);
    box-shadow: inset 0 1.5px 0 #fff, inset 0 0 0 1px rgba(224, 194, 127, .55), 0 -14px 26px -14px rgba(0, 0, 0, .7);
    transition: transform .55s var(--ease), margin .55s var(--ease), box-shadow .55s; }
  .fi-fiche:first-child { margin-top: 0; }
  .fi-onglet { position: absolute; top: -22px; left: calc(28px + var(--i) * 9%); padding: 2px 14px 4px; border-radius: 10px 10px 0 0; background: #FFFCF5;
    font-family: var(--serif); font-style: italic; font-weight: 700; font-size: 16px; color: #7A5E18; box-shadow: inset 0 1px 0 #fff, inset 0 0 0 1px rgba(224, 194, 127, .55); }
  .fi-ligne { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; }
  .fi-t { font-family: var(--serif); font-weight: 700; font-size: 24px; line-height: 1.1; color: var(--ink); }
  .fi-v { flex: none; font-family: var(--serif); font-weight: 700; font-size: 30px; line-height: 1; color: #6B5215; }
  .fi-corps { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; margin-top: 14px; opacity: 0; transition: opacity .35s; }
  .fi-q { font-size: 15.5px; line-height: 1.45; color: var(--ink2); }
  .fi-go { flex: none; font-size: 14px; font-weight: 700; color: #6E2632; }
  .fi-fiche:hover, .fi-fiche:focus-visible { transform: rotateX(0deg) translateY(-18px); margin-bottom: 70px;
    box-shadow: inset 0 1.5px 0 #fff, inset 0 0 0 1.5px #C4A24A, 0 30px 50px -20px rgba(0, 0, 0, .9); }
  .fi-fiche:hover .fi-corps, .fi-fiche:focus-visible .fi-corps { opacity: 1; }
  @media (max-width: 640px) {
    .fi-fiche { height: 132px; margin-top: -68px; padding: 10px 18px; }
    .fi-onglet { top: -20px; left: calc(14px + var(--i) * 7.5%); font-size: 14px; }
    .fi-t { font-size: 18px; }
    .fi-v { font-size: 22px; }
    .fi-go { display: none; }
  }
  @media (hover: none) { .fi-fiche:hover { transform: rotateX(-26deg); margin-bottom: 0; } .fi-fiche:hover .fi-corps { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .fi-fiche { transition: none; } }
</style>
