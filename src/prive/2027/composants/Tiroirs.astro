---
// Le tiroir à fiches — boussole des dix enjeux en meuble d'archives clair (chêne pâle, laiton).
// Tiroir ouvert = la fiche du dossier se pose sur le plan de lecture sous le meuble.
import { enjeux } from '../../../data/repliques2027.js';
const n2 = (i) => String(i + 1).padStart(2, '0');
---
<div class="tf">
  <div class="tf-meuble">
    {enjeux.map((e, i) => (
      e.statut === 'actif' ? (
        <button type="button" class="tf-tiroir" data-i={i} aria-expanded="false" aria-controls="tf-plan">
          <span class="tf-face">
            <span class="tf-etiquette"><b>{n2(i)}</b>{e.titre}</span>
            <span class="tf-poignee"></span>
          </span>
        </button>
      ) : (
        <div class="tf-tiroir ferme" aria-label={`${e.titre} : dossier en préparation`}>
          <span class="tf-face">
            <span class="tf-etiquette"><b>{n2(i)}</b>{e.titre}</span>
            <span class="tf-bientot">En préparation</span>
          </span>
        </div>
      )
    ))}
  </div>
  <div class="tf-socle"></div>
  <div class="tf-plan" id="tf-plan" aria-live="polite">
    <p class="tf-plan-vide">Ouvrez un tiroir pour sortir sa fiche.</p>
  </div>
  {enjeux.map((e, i) => e.statut === 'actif' && (
    <template id={`tf-fiche-${i}`}>
      <div class="tf-fiche">
        <span class="tf-fiche-k">Dossier {n2(i)}</span>
        <span class="tf-fiche-t">{e.titre}</span>
        <span class="tf-fiche-q">{e.question}</span>
        <span class="tf-fiche-v">{e.etat[0].valeur}</span>
        <span class="tf-fiche-p">{e.etat[0].phrase}</span>
        <a class="btn btn-or tf-fiche-go" href={`/2027/${e.id}/`}>Ouvrir le dossier <span class="ar">→</span></a>
      </div>
    </template>
  ))}
</div>

<style is:global>
  .tf { margin: 30px auto 0; max-width: 820px; }
  .tf-meuble { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 18px; perspective: 1600px; border-radius: 14px 14px 4px 4px; background: linear-gradient(180deg, #E4D6BE, #D2C1A3); border-top: 3px solid var(--or2); box-shadow: inset 0 0 0 1px rgba(154,123,46,.35), inset 0 18px 30px -20px rgba(255,255,255,.6), 0 40px 70px -46px rgba(14,12,10,.45); }
  .tf-socle { height: 16px; margin: 0 14px; border-radius: 0 0 8px 8px; background: linear-gradient(180deg, #BCA984, #9C8A66); }
  .tf-tiroir { position: relative; display: block; width: 100%; padding: 0; border: 0; background: none; font: inherit; color: inherit; cursor: pointer; transform-style: preserve-3d; outline-offset: 3px; }
  .tf-tiroir.ferme { cursor: default; }
  .tf-face { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; height: 88px; padding: 0 10px; border-radius: 6px; background: linear-gradient(180deg, #F7F1E6, #EADFCB); box-shadow: inset 0 1px 0 #fff, inset 0 -3px 0 rgba(122,94,24,.18), 0 2px 0 #B9A57F, 0 6px 10px -8px rgba(14,12,10,.35); transition: transform .45s var(--ease), box-shadow .45s; }
  .tf-tiroir:not(.ferme):hover .tf-face, .tf-tiroir:not(.ferme):focus-visible .tf-face { transform: translateZ(28px) translateY(-2px); box-shadow: inset 0 1px 0 #fff, 0 20px 26px -14px rgba(14,12,10,.45); }
  .tf-tiroir[aria-expanded="true"] .tf-face { transform: translateZ(52px) translateY(3px); box-shadow: inset 0 1px 0 #fff, 0 26px 32px -16px rgba(14,12,10,.5); }
  .tf-etiquette { display: inline-flex; align-items: baseline; gap: 6px; padding: 5px 14px; background: #FFFDF8; border: 1px solid #C4A24A; border-radius: 2px; font-size: 15px; font-weight: 600; line-height: 1.25; color: var(--ink); text-align: center; box-shadow: inset 0 0 0 2px #FFFDF8, inset 0 0 0 3px rgba(154,123,46,.3); }
  .tf-etiquette b { font-family: var(--serif); font-style: italic; color: #7A5E18; }
  .tf-poignee { width: 64px; height: 12px; border-radius: 0 0 14px 14px; background: linear-gradient(180deg, #FBEFC2, #C4A24A 50%, #8A6C21); box-shadow: 0 3px 4px rgba(14,12,10,.35); }
  .tf-tiroir.ferme .tf-face { background: linear-gradient(180deg, #EFE7D8, #E3D7C2); }
  .tf-tiroir.ferme .tf-etiquette { background: transparent; border-style: dashed; border-color: #A8946E; box-shadow: none; color: #4A4238; font-weight: 500; }
  .tf-bientot { font-size: 13px; font-weight: 600; color: #5E554A; }
  .tf-plan { margin: 26px auto 0; max-width: 640px; min-height: 120px; perspective: 1200px; }
  .tf-plan-vide { text-align: center; font-family: var(--serif); font-style: italic; font-size: 18px; color: #5E554A; margin: 40px auto 0; }
  .tf-fiche { display: flex; flex-direction: column; gap: 4px; padding: 26px 30px; background: #FFFDF8; border: 1px solid var(--r-filet); border-top: 2px solid var(--or2); border-radius: 10px; box-shadow: 0 40px 60px -40px rgba(14,12,10,.5); transform-origin: 50% 0; animation: tfSort .7s var(--ease) both; }
  @keyframes tfSort { from { opacity: 0; transform: translateY(-50px) rotateX(-50deg); } to { opacity: 1; transform: none; } }
  .tf-fiche-k { font-family: var(--mono); font-size: 13px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #7A5E18; }
  .tf-fiche-t { font-family: var(--serif); font-weight: 700; font-size: 30px; line-height: 1.1; color: var(--ink); }
  .tf-fiche-q { font-family: var(--serif); font-style: italic; font-size: 18px; color: var(--ink3); }
  .tf-fiche-v { font-family: var(--serif); font-weight: 700; font-size: 40px; line-height: 1; color: #7A5E18; margin-top: 14px; }
  .tf-fiche-p { font-size: 15.5px; line-height: 1.5; color: var(--ink2); }
  .tf-fiche-go { margin-top: 14px; align-self: flex-start; }
  @media (max-width: 640px) {
    .tf-meuble { gap: 8px; padding: 10px; }
    .tf-face { height: 78px; gap: 8px; }
    .tf-etiquette { flex-direction: column; align-items: center; gap: 0; font-size: 13.5px; padding: 4px 8px; }
    .tf-poignee { width: 44px; height: 9px; }
    .tf-bientot { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .tf-face { transition: none; } .tf-fiche { animation: none; } }
</style>

<script is:inline>
  (function () {
    var plan = document.getElementById('tf-plan');
    var tiroirs = document.querySelectorAll('.tf-tiroir:not(.ferme)');
    var vide = plan.innerHTML;
    tiroirs.forEach(function (t) {
      t.addEventListener('click', function () {
        var ouvrir = t.getAttribute('aria-expanded') !== 'true';
        tiroirs.forEach(function (x) { x.setAttribute('aria-expanded', 'false'); });
        if (!ouvrir) { plan.innerHTML = vide; return; }
        t.setAttribute('aria-expanded', 'true');
        plan.innerHTML = '';
        plan.appendChild(document.getElementById('tf-fiche-' + t.dataset.i).content.cloneNode(true));
        var r = plan.getBoundingClientRect();
        if (r.bottom > innerHeight) plan.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      });
    });
  })();
</script>
