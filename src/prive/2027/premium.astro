---
import Base from '../../layouts/Base.astro';
import '../../styles/repliques2027.css';
import { enjeux, quiz } from '../../data/repliques2027.js';
import { scrutins } from '../../data/votes2027.js';

// ============================================================
// LA BOUSSOLE 2027 — CINQ MISES EN PAGE de l'accueil (privé, dev seulement).
// Même contenu réel, cinq grammaires différentes, toutes à dominante crème.
// L'ancienne page de propositions reste sur /2027/premium-v1/.
// ============================================================
const n2 = (i) => String(i + 1).padStart(2, '0');
const liste = enjeux.map((e, i) => ({ ...e, n: n2(i), cle: e.statut === 'actif' ? e.etat[0].valeur : '', clePhrase: e.statut === 'actif' ? e.etat[0].phrase : '' }));
const actifs = liste.filter((e) => e.statut === 'actif');
const avenir = liste.filter((e) => e.statut !== 'actif');
const [vie, sal, imm] = actifs;
const nbScrutins = scrutins.filter((s) => s.confirme).length;
const ticks = Array.from({ length: 36 }, (_, i) => i * 10);

const mises = [
  { id: 'une', l: 'A', t: 'La Une', pour: 'Ton de presse sérieuse (l’esprit du Monde diplomatique), tout le contenu visible d’un coup d’œil, très crédible.', contre: 'Dense sur téléphone, il faut tout empiler.' },
  { id: 'index', l: 'B', t: 'L’Index', pour: 'Très lisible, très sobre, on compare les dix enjeux d’un regard et le chiffre-clé saute aux yeux.', contre: 'Moins d’émotion, peu de place pour l’image ou la 3D.' },
  { id: 'plein', l: 'C', t: 'Plein écran', pour: 'Un enjeu par écran, gros chiffres, rythme de récit : le plus « magazine » et le plus partageable en capture.', contre: 'Il faut faire défiler pour tout voir, moins pratique pour chercher.' },
  { id: 'atlas', l: 'D', t: 'L’Atlas', pour: 'La boussole au centre, sur crème : le nom devient la navigation, sans noir et or.', contre: 'Seuls les dossiers ouverts ont une vraie place, le reste passe au second plan.' },
  { id: 'carnet', l: 'E', t: 'Le Carnet', pour: 'Sommaire fixe à gauche, contenu qui défile à droite : idéal pour un outil qu’on consulte souvent.', contre: 'Sur téléphone, le sommaire doit devenir un menu.' },
];
---
<Base noVerset noindex title="Mises en page — La Boussole 2027" description="Cinq mises en page privées.">
  <div class="r27 mp">
    <section class="mp-intro">
      <div class="container">
        <p class="eyebrow">La Boussole 2027 · Atelier</p>
        <h1 class="mp-h1">Cinq mises en page pour l'accueil</h1>
        <p class="r27-intro">Même contenu, cinq façons de l'organiser. Choisissez une lettre pour l'afficher. Toutes restent à dominante crème, sans grand aplat noir. L'ancienne page de propositions est sur <a href="/2027/premium-v1/">/2027/premium-v1/</a>.</p>
      </div>
    </section>

    <nav class="mp-choix" aria-label="Mises en page">
      <div class="container mp-choix-in">
        {mises.map((m, i) => (
          <button type="button" class="mp-btn" aria-pressed={i === 0 ? 'true' : 'false'} data-m={m.id}><b>{m.l}</b> {m.t}</button>
        ))}
      </div>
    </nav>

    {mises.map((m, i) => (
      <section class="mp-bloc" id={`mp-${m.id}`} hidden={i !== 0}>
        <div class="container">
          <div class="mp-avis">
            <p><span class="mp-avis-k">Pour</span>{m.pour}</p>
            <p><span class="mp-avis-k">Contre</span>{m.contre}</p>
          </div>
        </div>

        {m.id === 'une' && (
          <div class="container">
            <div class="une">
              <header class="une-tete">
                <p class="une-ligne"><span>Présidentielle 2027</span><span>Édition de campagne</span><span>L'Autre Récit</span></p>
                <p class="une-titre">La Boussole</p>
                <p class="une-sous">Les enjeux de la campagne, chiffres et votes à l'appui</p>
              </header>
              <div class="une-grille">
                <article class="une-lead">
                  <p class="une-rub">{vie.titre} · Dossier {vie.n}</p>
                  <h2 class="une-h">{vie.question}</h2>
                  <p class="une-chiffre">{vie.cle}</p>
                  <p class="une-p">{vie.clePhrase} {vie.intro}</p>
                  <a class="une-lien" href={`/2027/${vie.id}/`}>Lire le dossier →</a>
                </article>
                <div class="une-cote">
                  {[sal, imm].map((e) => (
                    <article class="une-breve">
                      <p class="une-rub">{e.titre} · Dossier {e.n}</p>
                      <p class="une-chiffre petit">{e.cle}</p>
                      <h3 class="une-h3">{e.question}</h3>
                      <a class="une-lien" href={`/2027/${e.id}/`}>Lire →</a>
                    </article>
                  ))}
                </div>
              </div>
              <div class="une-bas">
                <div><p class="une-rub">Le jeu</p><p class="une-h3">Vrai ou cliché ? {quiz.length} phrases entendues partout, à trier.</p></div>
                <div><p class="une-rub">À l'Assemblée</p><p class="une-h3">Qui a voté quoi : {nbScrutins} scrutins relevés sur les salaires et la vie chère.</p></div>
                <div><p class="une-rub">À paraître</p><ul class="une-liste">{avenir.map((e) => <li>{e.titre}</li>)}</ul></div>
              </div>
            </div>
          </div>
        )}

        {m.id === 'index' && (
          <div class="container">
            <div class="idx">
              <div class="idx-g">
                <p class="eyebrow">Présidentielle 2027</p>
                <p class="idx-titre">La Boussole <span>2027</span></p>
                <p class="idx-p">Dix enjeux de la campagne. Pour chacun, l'état des lieux chiffré, les votes des députés et la réponse aux idées reçues.</p>
                <div class="idx-champ">On vous a dit… <span>« Les immigrés font baisser les salaires »</span></div>
              </div>
              <ol class="idx-liste">
                {liste.map((e) => (
                  <li class:list={['idx-ligne', { off: e.statut !== 'actif' }]}>
                    <span class="idx-n">{e.n}</span>
                    <span class="idx-t">{e.titre}<small>{e.question}</small></span>
                    <span class="idx-c">{e.cle || 'À paraître'}</span>
                    <span class="idx-f" aria-hidden="true">{e.statut === 'actif' ? '→' : ''}</span>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        )}

        {m.id === 'plein' && (
          <div class="container">
            <div class="plein" tabindex="0" aria-label="Défilez dans le cadre">
              <div class="plein-p plein-ouv">
                <p class="eyebrow">Présidentielle 2027</p>
                <p class="plein-titre">La Boussole</p>
                <p class="plein-sous">Trois dossiers ouverts. Faites défiler.</p>
                <span class="plein-fl" aria-hidden="true">↓</span>
              </div>
              {actifs.map((e, i) => (
                <div class:list={['plein-p', { sable: i % 2 === 0 }]}>
                  <span class="plein-geant">{e.cle}</span>
                  <div class="plein-txt">
                    <p class="eyebrow">Dossier {e.n} · {e.titre}</p>
                    <p class="plein-q">{e.question}</p>
                    <p class="plein-phr">{e.clePhrase}</p>
                    <a class="btn btn-or" href={`/2027/${e.id}/`}>Ouvrir le dossier <span class="ar">→</span></a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {m.id === 'atlas' && (
          <div class="container">
            <div class="atlas">
              <a class="atlas-carte n" href={`/2027/${vie.id}/`}><span class="atlas-k">Nord · Dossier {vie.n}</span><span class="atlas-t">{vie.titre}</span><span class="atlas-c">{vie.cle}</span><span class="atlas-q">{vie.question}</span></a>
              <a class="atlas-carte o" href={`/2027/${sal.id}/`}><span class="atlas-k">Ouest · Dossier {sal.n}</span><span class="atlas-t">{sal.titre}</span><span class="atlas-c">{sal.cle}</span><span class="atlas-q">{sal.question}</span></a>
              <div class="atlas-rose">
                <svg viewBox="-120 -120 240 240" aria-hidden="true">
                  <circle r="112" fill="#FBF8F2" stroke="#9A7B2E" stroke-width="2" />
                  <circle r="100" fill="none" stroke="rgba(154,123,46,.35)" />
                  {ticks.map((t) => <line x1="0" y1="-112" x2="0" y2={t % 90 === 0 ? -98 : -106} stroke="#9A7B2E" stroke-width={t % 90 === 0 ? 2 : 1} transform={`rotate(${t})`} />)}
                  <g fill="#C4A24A"><polygon points="0,-84 10,-10 0,0 -10,-10" /><polygon points="84,0 10,10 0,0 10,-10" opacity=".45" /><polygon points="0,84 -10,10 0,0 10,10" opacity=".45" /><polygon points="-84,0 -10,-10 0,0 -10,10" opacity=".45" /></g>
                  <g class="atlas-aig"><polygon points="0,-70 6,0 -6,0" fill="#1A1714" /><polygon points="0,70 6,0 -6,0" fill="#B8A47E" /><circle r="7" fill="#C4A24A" stroke="#1A1714" stroke-width="2" /></g>
                  <text y="-88" text-anchor="middle" class="atlas-nsew">N</text>
                </svg>
                <p class="atlas-nom">La Boussole <span>2027</span></p>
              </div>
              <a class="atlas-carte e" href={`/2027/${imm.id}/`}><span class="atlas-k">Est · Dossier {imm.n}</span><span class="atlas-t">{imm.titre}</span><span class="atlas-c">{imm.cle}</span><span class="atlas-q">{imm.question}</span></a>
              <div class="atlas-sud"><span class="atlas-k">Sud · À paraître</span><p>{avenir.map((e) => e.titre).join(' · ')}</p></div>
            </div>
          </div>
        )}

        {m.id === 'carnet' && (
          <div class="container">
            <div class="carnet">
              <aside class="carnet-g">
                <svg class="carnet-rose" viewBox="-40 -40 80 80" aria-hidden="true"><circle r="36" fill="#FBF8F2" stroke="#9A7B2E" stroke-width="2" /><polygon points="0,-28 5,0 -5,0" fill="#1A1714" /><polygon points="0,28 5,0 -5,0" fill="#B8A47E" /><circle r="4" fill="#C4A24A" /></svg>
                <p class="carnet-titre">La Boussole 2027</p>
                <ol class="carnet-som">
                  {liste.map((e) => <li class:list={{ off: e.statut !== 'actif' }}><span>{e.n}</span>{e.titre}</li>)}
                </ol>
                <p class="carnet-meta">{actifs.length} dossiers ouverts · {nbScrutins} votes relevés</p>
              </aside>
              <div class="carnet-d">
                <p class="carnet-acc">Les vrais enjeux de la campagne, et de quoi répondre aux idées reçues qui les accompagnent.</p>
                {actifs.map((e) => (
                  <article class="carnet-carte">
                    <span class="carnet-c">{e.cle}</span>
                    <div><p class="eyebrow">Dossier {e.n}</p><p class="carnet-t">{e.titre}</p><p class="carnet-q">{e.question}</p></div>
                  </article>
                ))}
                <article class="carnet-carte jeu"><div><p class="eyebrow">Échauffement</p><p class="carnet-t">Vrai ou cliché ?</p><p class="carnet-q">{quiz.length} phrases à trier avant le prochain repas de famille.</p></div></article>
                <article class="carnet-carte"><div><p class="eyebrow">À l'Assemblée</p><p class="carnet-t">Qui a voté quoi</p><p class="carnet-q">{nbScrutins} scrutins publics, groupe par groupe.</p></div></article>
              </div>
            </div>
          </div>
        )}
      </section>
    ))}
  </div>
</Base>

<style is:global>
  .mp { padding-bottom: 60px; }
  .mp .eyebrow { color: #7A5E18; font-size: 13px; }
  .mp-intro { padding-top: clamp(118px, 13vw, 150px); }
  .mp-h1 { font-size: clamp(34px, 5vw, 56px); margin: 6px 0 0; }
  .mp-choix { position: sticky; top: 82px; z-index: 20; margin-top: 26px; padding: 12px 0; background: rgba(242,237,228,.94); backdrop-filter: blur(6px); border-block: 1px solid var(--r-filet); }
  .mp-choix-in { display: flex; flex-wrap: wrap; gap: 8px; }
  .mp-btn { font: inherit; font-size: 15px; font-weight: 600; padding: 8px 16px; border-radius: 100px; border: 1px solid #8E7B58; background: #fff; color: var(--ink2); cursor: pointer; }
  .mp-btn b { font-family: var(--serif); font-style: italic; color: #7A5E18; margin-right: 4px; }
  .mp-btn[aria-pressed="true"] { background: var(--ink); color: #F2EDE4; border-color: var(--ink); }
  .mp-btn[aria-pressed="true"] b { color: var(--or3); }
  .mp-bloc { padding-top: 26px; }
  .mp-avis { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 22px; }
  .mp-avis p { margin: 0; font-size: 15px; line-height: 1.5; color: var(--ink3); padding: 12px 16px; background: var(--r-carte); border: 1px solid var(--r-filet); border-radius: 10px; max-width: none; }
  .mp-avis-k { display: block; font-family: var(--mono); font-size: 13px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #7A5E18; margin-bottom: 2px; }

  /* ===== A · LA UNE ===== */
  .une { background: #F8F3E9; border: 1px solid var(--r-filet); padding: clamp(20px, 3vw, 40px); box-shadow: 0 30px 60px -50px rgba(14,12,10,.5); }
  .une-tete { text-align: center; border-bottom: 3px double var(--ink); padding-bottom: 14px; }
  .une-ligne { display: flex; justify-content: space-between; gap: 10px; margin: 0; max-width: none; padding-bottom: 8px; border-bottom: 1px solid var(--ink); font-family: var(--mono); font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--ink3); }
  .une-titre { font-family: var(--serif); font-weight: 900; font-size: clamp(54px, 10vw, 128px); line-height: 1; letter-spacing: -0.03em; color: var(--ink); margin: 10px auto 0; max-width: none; }
  .une-sous { font-family: var(--serif); font-style: italic; font-size: clamp(17px, 2vw, 22px); color: var(--ink3); margin: 6px auto 0; max-width: none; }
  .une-grille { display: grid; grid-template-columns: 1.6fr 1fr; gap: 0; margin-top: 24px; }
  .une-lead { padding-right: 28px; border-right: 1px solid var(--ink); }
  .une-cote { padding-left: 28px; display: grid; }
  .une-breve + .une-breve { border-top: 1px solid var(--cr3); margin-top: 18px; padding-top: 18px; }
  .une-rub { font-family: var(--mono); font-size: 13px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #7A5E18; margin: 0; }
  .une-h { font-family: var(--serif); font-weight: 700; font-size: clamp(28px, 3.4vw, 44px); line-height: 1.08; margin: 8px 0 0; }
  .une-h3 { font-family: var(--serif); font-weight: 700; font-size: 20px; line-height: 1.25; color: var(--ink); margin: 6px 0 0; }
  .une-chiffre { font-family: var(--serif); font-weight: 700; font-size: clamp(56px, 7vw, 88px); line-height: 1; color: #7A5E18; margin: 14px 0 0; letter-spacing: -0.03em; }
  .une-chiffre.petit { font-size: 46px; margin-top: 8px; }
  .une-p { font-size: 16.5px; line-height: 1.6; color: var(--ink2); margin: 12px 0 0; column-count: 2; column-gap: 24px; max-width: none; }
  .une-lien { display: inline-block; margin-top: 12px; font-weight: 700; color: var(--ink); border-bottom: 2px solid var(--or2); }
  .une-bas { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 26px; border-top: 3px double var(--ink); }
  .une-bas > div { padding: 16px 18px 0; }
  .une-bas > div + div { border-left: 1px solid var(--cr3); }
  .une-liste { margin: 8px 0 0; padding: 0; list-style: none; font-size: 15px; line-height: 1.7; color: var(--ink3); columns: 2; }

  /* ===== B · L'INDEX ===== */
  .idx { display: grid; grid-template-columns: .9fr 1.3fr; gap: clamp(24px, 4vw, 56px); align-items: start; }
  .idx-g { position: sticky; top: 160px; }
  .idx-titre { font-family: var(--serif); font-weight: 900; font-size: clamp(48px, 6.4vw, 84px); line-height: .98; letter-spacing: -0.03em; color: var(--ink); margin: 6px 0 0; }
  .idx-titre span { display: block; font-style: italic; font-weight: 400; color: #7A5E18; }
  .idx-p { font-size: 17px; line-height: 1.6; color: var(--ink3); margin: 16px 0 0; }
  .idx-champ { margin-top: 20px; padding: 14px 16px; background: #fff; border: 1.5px solid #8E7B58; border-radius: 6px; font-family: var(--serif); font-style: italic; color: var(--ink); }
  .idx-champ span { display: block; font-family: var(--sans); font-style: normal; font-size: 15px; color: #7A6F62; margin-top: 4px; }
  .idx-liste { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .idx-ligne { display: grid; grid-template-columns: 48px 1fr auto 24px; gap: 16px; align-items: center; padding: 18px 8px; border-bottom: 1px solid var(--cr3); transition: background .2s, padding .2s; cursor: pointer; }
  .idx-ligne:hover { background: #fff; padding-left: 16px; box-shadow: inset 3px 0 0 var(--or2); }
  .idx-n { font-family: var(--serif); font-style: italic; font-size: 20px; color: #7A5E18; }
  .idx-t { font-family: var(--serif); font-weight: 700; font-size: 23px; color: var(--ink); }
  .idx-t small { display: block; font-family: var(--sans); font-weight: 400; font-size: 15px; color: var(--ink3); margin-top: 2px; }
  .idx-c { font-family: var(--serif); font-weight: 700; font-size: 26px; color: #7A5E18; white-space: nowrap; }
  .idx-f { font-size: 20px; color: var(--ink); }
  .idx-ligne.off { cursor: default; }
  .idx-ligne.off:hover { background: none; padding-left: 8px; box-shadow: none; }
  .idx-ligne.off .idx-t { color: #4A4238; font-weight: 500; }
  .idx-ligne.off .idx-c { font-family: var(--sans); font-size: 14px; font-weight: 600; color: #5E554A; }

  /* ===== C · PLEIN ÉCRAN ===== */
  .plein { height: min(78vh, 680px); overflow-y: auto; scroll-snap-type: y mandatory; border-radius: 16px; border: 1px solid var(--r-filet); outline-offset: 4px; }
  .plein-p { min-height: 100%; scroll-snap-align: start; display: grid; grid-template-columns: 1.1fr 1fr; gap: 32px; align-items: center; padding: clamp(28px, 5vw, 64px); background: #FBF8F2; }
  .plein-p.sable { background: #EADFCB; }
  .plein-ouv { grid-template-columns: 1fr; text-align: center; justify-items: center; background: radial-gradient(120% 90% at 50% 30%, #FFFDF8, #EFE6D6); }
  .plein-titre { font-family: var(--serif); font-weight: 900; font-size: clamp(64px, 11vw, 140px); line-height: 1; letter-spacing: -0.03em; color: var(--ink); margin: 8px 0 0; }
  .plein-sous { font-family: var(--serif); font-style: italic; font-size: 20px; color: var(--ink3); margin: 6px 0 0; }
  .plein-fl { margin-top: 20px; font-size: 28px; color: #7A5E18; animation: pleinFl 1.6s ease-in-out infinite; }
  @keyframes pleinFl { 50% { transform: translateY(8px); } }
  .plein-geant { font-family: var(--serif); font-weight: 900; font-size: clamp(80px, 13vw, 170px); line-height: .9; letter-spacing: -0.045em; color: var(--ink); }
  .plein-q { font-family: var(--serif); font-weight: 700; font-size: clamp(26px, 3vw, 38px); line-height: 1.12; color: var(--ink); margin: 8px 0 0; }
  .plein-phr { font-size: 17px; line-height: 1.55; color: var(--ink2); margin: 12px 0 20px; }

  /* ===== D · L'ATLAS ===== */
  .atlas { display: grid; grid-template-columns: 1fr minmax(260px, 340px) 1fr; grid-template-areas: ". n ." "o r e" ". s ."; gap: 22px; align-items: center; padding: clamp(20px, 3vw, 40px); background: radial-gradient(70% 60% at 50% 50%, #FFFDF8, #EFE6D6); border-radius: 18px; border: 1px solid var(--r-filet); }
  .atlas-carte { display: grid; gap: 4px; padding: 20px 22px; color: inherit; background: #fff; border: 1px solid var(--r-filet); border-top: 2px solid var(--or2); border-radius: 12px; box-shadow: 0 24px 40px -34px rgba(14,12,10,.5); transition: transform .3s var(--ease), box-shadow .3s; }
  .atlas-carte:hover { color: inherit; transform: translateY(-4px); box-shadow: 0 30px 50px -30px rgba(14,12,10,.5); }
  .atlas-carte.n { grid-area: n; text-align: center; }
  .atlas-carte.o { grid-area: o; }
  .atlas-carte.e { grid-area: e; }
  .atlas-k { font-family: var(--mono); font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #7A5E18; }
  .atlas-t { font-family: var(--serif); font-weight: 700; font-size: 26px; color: var(--ink); }
  .atlas-c { font-family: var(--serif); font-weight: 700; font-size: 38px; line-height: 1; color: #7A5E18; }
  .atlas-q { font-size: 15px; line-height: 1.45; color: var(--ink3); }
  .atlas-rose { grid-area: r; text-align: center; }
  .atlas-rose svg { width: 100%; max-width: 300px; filter: drop-shadow(0 24px 30px rgba(14,12,10,.18)); }
  .atlas-aig { animation: atlasAig 6s ease-in-out infinite; transform-origin: 0 0; }
  @keyframes atlasAig { 0%, 100% { transform: rotate(-6deg); } 50% { transform: rotate(6deg); } }
  .atlas-nsew { font-family: 'Playfair Display', serif; font-weight: 700; font-size: 14px; fill: #1A1714; }
  .atlas-nom { font-family: var(--serif); font-weight: 900; font-size: clamp(28px, 3.4vw, 40px); color: var(--ink); margin: 8px auto 0; max-width: none; }
  .atlas-nom span { font-style: italic; font-weight: 400; color: #7A5E18; }
  .atlas-sud { grid-area: s; text-align: center; }
  .atlas-sud p { margin: 6px auto 0; font-size: 15px; line-height: 1.6; color: var(--ink3); }

  /* ===== E · LE CARNET ===== */
