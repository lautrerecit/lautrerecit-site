<script is:inline>
  (function () {
    var btns = document.querySelectorAll('.mp-btn');
    function montrer(id) {
      btns.forEach(function (b) { b.setAttribute('aria-pressed', b.dataset.m === id ? 'true' : 'false'); });
      document.querySelectorAll('.mp-bloc').forEach(function (s) { s.hidden = s.id !== 'mp-' + id; });
      try { history.replaceState(null, '', '#' + id); } catch (e) {}
    }
    btns.forEach(function (b) { b.addEventListener('click', function () { montrer(b.dataset.m); }); });
    var h = location.hash.slice(1); if (h && document.getElementById('mp-' + h)) montrer(h);
  })();
</script>
